# Step2API Environment Configuration
STEP2API_HOST=127.0.0.1
STEP2API_PORT=5001

# Admin API key (for management endpoints)
STEP2API_ADMIN_KEY=change-me-to-a-strong-password

# Config file path
STEP2API_CONFIG_PATH=config.json

# Or provide config as Base64 encoded JSON
# STEP2API_CONFIG_JSON=

# Concurrency settings
STEP2API_ACCOUNT_MAX_INFLIGHT=2
STEP2API_ACCOUNT_MAX_QUEUE=4
